# Copy to .env for local development. Never commit real values.
REGISTRY_DATABASE_URL=postgres://tangent:tangent@127.0.0.1:54329/registry
# At least 32 characters in production, and different from JWT_SECRET.
SECRETS_KEY=change-me-to-a-long-random-string-0123456789
JWT_SECRET=change-me-to-another-long-random-string-0123
# Previous JWT secret during a rotation. Leave unset otherwise.
# JWT_SECRET_PREVIOUS=
PORT=4000
# In production this must be the admin and console origins, not *.
CORS_ORIGINS=*
ADMIN_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
# A fixed second step for console sign-in on local and test tracks (school sign-in codes always go to the school's
# messages: the Test inbox in sandbox mode). Only on a developer's machine and in tests: a production server ignores it and
# every console account signs in with an authenticator app.
DEMO_CODE=424242
# The password tools/dataset/load.mjs gives the test school's staff; the tools sign in with it (codes come from the Test inbox).
TEST_PASSWORD=sunrise-valley-26
# ALLOW_DEMO=false
# Tenant pools: TENANT_MAX_POOLS × TENANT_PER_POOL, plus ~8 for the registry
# and ~8 for the console, must stay under Postgres max_connections (often 100).
# The defaults, 20 × 3 = 60 plus ~16, fit a 100-connection database. Behind a
# transaction pooler (PgBouncer, Neon's -pooler address) they can go higher.
# TENANT_MAX_POOLS=20
# TENANT_PER_POOL=3
# A Slack or Discord incoming webhook for alerts: new errors, a school not answering,
# a failed backup or restore drill, a school that could not be migrated at start-up.
# ALERT_WEBHOOK_URL=
# Keep backups in a database of their own (recommended in production).
# BACKUP_DATABASE_URL=
# Optional: Neon API key for one project per test school; GitHub for build profiles and app builds.
# NEON_API_KEY=
# GITHUB_TOKEN=
# GITHUB_REPO=owner/repo
# How many proxies sit in front of the server (1: one load balancer), their addresses or ranges ("10.0.0.0/8"), or false when
# clients connect to the server directly. Per-device sign-in limits trust the client address only from these. Never true.
# TRUST_PROXY=1
# Seals school backups (at least 32 characters). Without it a key of its own is derived from SECRETS_KEY.
# BACKUP_KEY=
# A registry login for the school API that cannot open the console's tables (tools/registry-api-role.sql).
# API_REGISTRY_DATABASE_URL=
# Hosts on a private network that a typed-in integration address (a custom SMS gateway, a webhook) may still reach.
# ALLOW_PRIVATE_HOSTS=
# For the tools on a server whose console account already has an authenticator: its key, or a code from it typed now.
# CONSOLE_TOTP_SECRET=
# CONSOLE_CODE=
