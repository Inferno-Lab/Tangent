 "onboarding.kid_a_big": "7:52 ला पोहोचले",
 "onboarding.kid_a_line": "हजर · आत्ता संगणक · 1 काम देय",
 "onboarding.kid_a_over": "Aarav · वर्ग 8 A",
 "onboarding.kid_b_big": "8:04 ला पोहोचले",
 "onboarding.kid_b_line": "हजर · या आठवड्यात काही देय नाही",
 "onboarding.kid_b_over": "Ananya · वर्ग 5 B",
 "onboarding.now": "आता",
 "onboarding.one_body": "आजच्या तासिका, खोल्या आणि शिक्षक एका यादीत, सध्याची तासिका शाळेच्या रंगात.",
 "onboarding.one_kicker": "विद्यार्थ्यांसाठी",
 "onboarding.one_title": "घंटेपूर्वी कुठे असायचे ते जाणून घ्या.",
 "onboarding.page_of": "3 पैकी @n",
 "onboarding.tally_absent": "2 गैरहजर",
 "onboarding.tally_late": "1 उशिरा",
 "onboarding.tally_present": "17 हजर",
 "onboarding.three_body": "सर्वजण हजर म्हणून सुरू होतात, म्हणून तुम्ही फक्त गैरहजरांना टॅप करता. गृहपाठ, तपासणी, गुण आणि सूचना त्याच स्क्रीनवर आहेत.",
 "onboarding.three_kicker": "शिक्षकांसाठी",
 "onboarding.three_title": "सहा टॅपमध्ये हजेरी.",
 "onboarding.two_body": "प्रत्येक मुलाचे आगमन, हजेरी, शुल्क आणि गृहपाठ, तसेच उशीर होण्यापूर्वी आठवण. कोणत्याही स्क्रीनच्या वरून मूल बदला.",
 "onboarding.two_kicker": "पालकांसाठी",
 "onboarding.two_title": "प्रत्येक मूल, एका दृष्टीक्षेपात.",
 "privacy.agree": "मी सहमत आहे",
 "privacy.consent_intro": "शाळा चालवण्यासाठी @school तुमच्या कुटुंबाचे तपशील ठेवते. ते कसे वापरले जातात ते कृपया वाचा.",
 "privacy.consent_title": "सुरू करण्यापूर्वी",
 "privacy.default_notice": "शाळा तुमच्या कुटुंबाचे तपशील फक्त शाळा चालवण्यासाठी वापरते: हजेरी, शुल्क, गृहपाठ, निकाल आणि संदेश. ते शाळेसाठी Tangent च्या डेटाबेसमध्ये ठेवले जातात आणि कधीही विकले जात नाहीत किंवा जाहिरातीसाठी वापरले जात नाहीत. संपूर्ण गोपनीयता सूचनेसाठी शाळा कार्यालयाला विचारा.",
